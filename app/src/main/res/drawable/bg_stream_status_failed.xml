<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded red pill shown when a stream returned HTTP 2xx (reached the server)
    but the response headers indicate it is not a valid video stream — e.g. the
    provider returned an HTML error page, a login redirect, or a blank body.
    This differs from an HTTP error (4xx/5xx) which carries no badge at all;
    the "stream failed" badge specifically signals that the probe reached the
    CDN but the stream itself is not playable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#8B1A1A" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#D94040" />
</shape>
