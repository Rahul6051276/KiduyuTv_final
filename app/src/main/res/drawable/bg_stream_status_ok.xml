<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded green pill used to mark a stream whose upstream URL answered
    with a 2xx response during the background validation probe.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1F8E3A" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#3DC25A" />
</shape>
