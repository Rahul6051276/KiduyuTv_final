<?xml version="1.0" encoding="utf-8"?>
<!--
    Tabbed track-selection dialog.

    Layout:
      - compact centered card (the Dialog window provides outside dimming)
      - card body: header → 3-button tab strip → divider → list → close button
    The list content is swapped when the user switches tabs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_direct_stream_dialog"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/track_settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Tab strip: Video / Audio / Subtitle.  Each tab is a focusable TextView. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabVideo"
                style="@style/DirectStreamTrackTab"
                android:nextFocusDown="@id/listTracks"
                android:text="@string/track_video" />

            <TextView
                android:id="@+id/tabAudio"
                style="@style/DirectStreamTrackTab"
                android:layout_marginStart="8dp"
                android:nextFocusDown="@id/listTracks"
                android:text="@string/track_audio" />

            <TextView
                android:id="@+id/tabSubtitle"
                style="@style/DirectStreamTrackTab"
                android:layout_marginStart="8dp"
                android:nextFocusDown="@id/listTracks"
                android:text="@string/track_subtitle" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/kiduyu_red" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp">

            <ListView
                android:id="@+id/listTracks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@android:color/transparent"
                android:clickable="true"
                android:divider="@null"
                android:focusable="true"
                android:nextFocusDown="@id/btnClose"
                android:listSelector="@drawable/bg_direct_stream_track_row" />

            <TextView
                android:id="@+id/emptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="24dp"
                android:text="@string/track_none_available"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:background="@drawable/direct_stream_back_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/listTracks"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/track_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
</LinearLayout>
