<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/loadingArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <ImageView
            android:id="@+id/loadingBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlayControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="#B8000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnPlayerBack"
                style="@style/DirectStreamControlButton"
                android:layout_width="48dp"
                android:contentDescription="@string/back"
                android:nextFocusDown="@id/btnPlayPause"
                android:text="‹" />

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="#BBBBBB"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnRewind"
            style="@style/DirectStreamControlButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="24dp"
            android:contentDescription="@string/skip_back"
            android:nextFocusDown="@id/btnFill"
            android:nextFocusRight="@id/btnPlayPause"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="−10" />

        <TextView
            android:id="@+id/btnForward"
            style="@style/DirectStreamControlButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/skip_forward"
            android:nextFocusDown="@id/btnVolume"
            android:nextFocusLeft="@id/btnPlayPause"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="+10" />

        <TextView
            android:id="@+id/btnPlayPause"
            style="@style/DirectStreamControlButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/player_play_pause"
            android:nextFocusDown="@id/btnFill"
            android:nextFocusLeft="@id/btnRewind"
            android:nextFocusRight="@id/btnForward"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="Ⅱ"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/videoBottomStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B8000000"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:max="1000"
                    android:progressTint="@color/kiduyu_red"
                    android:secondaryProgressTint="#FFFFFF"
                    android:thumbTint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPreviousEpisode"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:contentDescription="@string/player_previous_episode_cd"
                    android:drawableStart="@drawable/ic_direct_stream_episode_previous"
                    android:drawablePadding="6dp"
                    android:text="@string/player_previous_episode"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnFill"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:layout_marginStart="8dp"
                    android:nextFocusLeft="@id/btnVolume"
                    android:nextFocusRight="@id/btnPlayPause"
                    android:nextFocusUp="@id/btnRewind"
                    android:text="@string/player_fit" />

                <TextView
                    android:id="@+id/btnPlayerTracks"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/track_settings_cd"
                    android:nextFocusLeft="@id/btnPlayPause"
                    android:nextFocusRight="@id/btnPlayerStreams"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:text="@string/track_settings"
                    android:visibility="gone" />

                <!-- Replaces Favorite from the supplied IPTV player. -->
                <TextView
                    android:id="@+id/btnPlayerStreams"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="120dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/stream_sources_cd"
                    android:drawableStart="@drawable/ic_direct_stream_cloud"
                    android:drawablePadding="8dp"
                    android:nextFocusLeft="@id/btnPlayerTracks"
                    android:nextFocusRight="@id/btnVolume"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/stream_sources"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnVolume"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/player_volume"
                    android:nextFocusLeft="@id/btnPlayerStreams"
                    android:nextFocusRight="@id/btnFill"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:text="VOL" />

                <TextView
                    android:id="@+id/btnNextEpisode"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/player_next_episode_cd"
                    android:drawableStart="@drawable/ic_direct_stream_episode_next"
                    android:drawablePadding="6dp"
                    android:text="@string/player_next_episode"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Kept outside overlayControls so buffering remains visible after
         the playback controls automatically hide. -->
    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/direct_stream_back_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/streams_loading"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
