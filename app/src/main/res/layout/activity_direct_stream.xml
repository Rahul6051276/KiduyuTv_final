<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/loadingArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <ImageView
            android:id="@+id/loadingBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlayControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_direct_stream_top_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btnPlayerBack"
                style="@style/DirectStreamControlButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/back"
                android:nextFocusDown="@id/btnPlayPause"
                android:text="‹"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="#BBBBBB"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnRewind"
            style="@style/DirectStreamRoundControlButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="24dp"
            android:contentDescription="@string/skip_back"
            android:nextFocusDown="@id/btnFill"
            android:nextFocusRight="@id/btnPlayPause"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="@string/direct_stream_rewind_30" />

        <TextView
            android:id="@+id/btnForward"
            style="@style/DirectStreamRoundControlButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/skip_forward"
            android:nextFocusDown="@id/btnVolume"
            android:nextFocusLeft="@id/btnPlayPause"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="@string/direct_stream_forward_30" />

        <TextView
            android:id="@+id/btnPlayPause"
            style="@style/DirectStreamPlayControlButton"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:contentDescription="@string/player_play_pause"
            android:nextFocusDown="@id/btnFill"
            android:nextFocusLeft="@id/btnRewind"
            android:nextFocusRight="@id/btnForward"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="Ⅱ"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/videoBottomStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_direct_stream_bottom_scrim"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:max="1000"
                    android:progressTint="@color/kiduyu_red"
                    android:secondaryProgressTint="#80FFFFFF"
                    android:thumbTint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPreviousEpisode"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:contentDescription="@string/player_previous_episode_cd"
                    android:drawableStart="@drawable/ic_direct_stream_episode_previous"
                    android:drawablePadding="6dp"
                    android:text="@string/player_previous_episode"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnFill"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:layout_marginStart="8dp"
                    android:nextFocusLeft="@id/btnVolume"
                    android:nextFocusRight="@id/btnPlayPause"
                    android:nextFocusUp="@id/btnRewind"
                    android:text="@string/player_fit" />

                <TextView
                    android:id="@+id/btnPlayerSubtitles"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="88dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/subdl_subtitles_cd"
                    android:nextFocusLeft="@id/btnFill"
                    android:nextFocusRight="@id/btnPlayerTracks"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:text="@string/subdl_subtitles" />

                <TextView
                    android:id="@+id/btnPlayerTracks"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/track_settings_cd"
                    android:nextFocusLeft="@id/btnPlayPause"
                    android:nextFocusRight="@id/btnPlayerStreams"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:text="@string/track_settings"
                    android:visibility="gone" />

                <!-- Replaces Favorite from the supplied IPTV player. -->
                <TextView
                    android:id="@+id/btnPlayerStreams"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="120dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/stream_sources_cd"
                    android:drawableStart="@drawable/ic_direct_stream_cloud"
                    android:drawablePadding="8dp"
                    android:nextFocusLeft="@id/btnPlayerTracks"
                    android:nextFocusRight="@id/btnVolume"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/stream_sources"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnVolume"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/player_volume"
                    android:nextFocusLeft="@id/btnPlayerStreams"
                    android:nextFocusRight="@id/btnFill"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:text="VOL" />

                <TextView
                    android:id="@+id/btnNextEpisode"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="76dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/player_next_episode_cd"
                    android:drawableStart="@drawable/ic_direct_stream_episode_next"
                    android:drawablePadding="6dp"
                    android:text="@string/player_next_episode"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnEpisodes"
                    style="@style/DirectStreamControlButton"
                    android:layout_width="92dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/player_episodes_cd"
                    android:drawableStart="@drawable/ic_direct_stream_episodes"
                    android:drawablePadding="6dp"
                    android:nextFocusUp="@id/btnPlayerBack"
                    android:nextFocusDown="@id/btnPlayPause"
                    android:text="@string/player_episodes"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Scrim that fades in over the player while the panel is open.
         Keep it behind the panel so touch scrolls on the RecyclerView are not
         intercepted by the dimming overlay. -->
    <View
        android:id="@+id/episodesPanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- ============================================================== -->
    <!--  Episodes side panel                                           -->
    <!--  Sits on top of overlayControls. Toggled by btnEpisodes.       -->
    <!--  translationX is animated by DirectStreamActivity.             -->
    <!-- ============================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/episodesPanelContainer"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:translationX="-360dp"
        android:visibility="gone"
        android:nextFocusRight="@id/btnEpisodes"
        app:cardBackgroundColor="@color/direct_stream_surface_high"
        app:cardCornerRadius="28dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/direct_stream_outline"
        app:strokeWidth="1dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/direct_stream_surface_high">

            <!-- Panel header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvEpisodesPanelHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Season 1 — 13 episodes"
                    xmlns:tools="http://schemas.android.com/tools" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseEpisodesPanel"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/close"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="×"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    app:backgroundTint="@color/direct_stream_surface"
                    app:cornerRadius="21dp"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/direct_stream_outline"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/direct_stream_outline" />

            <!-- Status row shown while loading or on error -->
            <TextView
                android:id="@+id/tvEpisodesPanelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                xmlns:tools="http://schemas.android.com/tools"
                tools:text="@string/episode_panel_loading" />

            <!-- Episode list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Kept outside overlayControls so buffering remains visible after
         the playback controls automatically hide. -->
    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_direct_stream_status"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/streams_loading"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
